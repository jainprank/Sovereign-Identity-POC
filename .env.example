# Copy to .env and adjust as needed. Used by both docker-compose (infra/docker-compose.yml)
# and the Spring Boot app (backend/app/src/main/resources/application.yml) for local dev.

# --- Database ---
DATABASE_NAME=idtrust
DATABASE_USERNAME=idtrust
DATABASE_PASSWORD=idtrust
DATABASE_URL=jdbc:postgresql://localhost:5432/idtrust

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Keycloak (wired up in E02) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=idtrust
KEYCLOAK_CLIENT_ID=idtrust-app
KEYCLOAK_CLIENT_SECRET=

# --- KMS (wired up in E05) ---
KMS_PROVIDER=internal
# AES-256 key-encryption-key (base64), used to encrypt private key material at rest. Generate a
# real one with `openssl rand -base64 32` for anything beyond local dev - the app falls back to
# an insecure all-zero default if this is left blank (see application.yml).
KMS_MASTER_KEY_BASE64=

# --- Hedera (wired up in E13) ---
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
